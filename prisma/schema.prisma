generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  draft
  submitted
  intake_triage_in_progress
  awaiting_client_documents
  document_review_in_progress
  risk_review_in_progress
  preliminary_points_review_in_progress
  senior_review_in_progress
  ready_for_client_summary
  client_summary_sent
  on_hold
  closed
}

enum DocumentType {
  passportBioPage
  resume
  qualificationsDoc
  transcripts
  englishResultDoc
  skillsAssessmentDoc
  refusalDocs
  otherSupportingDocs
}

enum DocumentVerificationStatus {
  not_uploaded
  uploaded_unchecked
  under_review
  verified
  rejected
  needs_reupload
}

enum UploadedBy {
  client
  staff
}

enum ReviewStage {
  intake_triage
  document_completeness_check
  risk_assessment
  preliminary_points_review
  senior_consultant_check
  client_summary_ready
}

enum ReviewDecision {
  insufficient_information
  needs_more_documents
  needs_risk_clarification
  ready_for_consultant_summary
  manual_hold
}

enum RiskSeverity {
  low
  medium
  high
  critical
}

enum RiskDetectedBy {
  system
  staff
}

enum RiskResolutionStatus {
  open
  under_review
  resolved
  accepted_with_controls
}

enum ConsultationBookingStatus {
  invited
  booked
  completed
  no_show
  cancelled
  rescheduled
}

enum ConsultationBookingSource {
  manual_staff_entry
  internal_booking_link
  calendly
  google_calendar
  other
}

enum PointsGeneratedBy {
  system
  staff
}

enum AuditEventType {
  submission_created
  submission_updated
  submission_submitted
  document_uploaded
  document_verified
  document_rejected
  status_transition_executed
  risk_flag_created
  risk_flag_resolved
  points_snapshot_generated
  points_snapshot_regenerated
  client_comm_drafted
  client_comm_release_requested
  client_comm_released
  client_comm_release_blocked
  review_note_added
  risk_escalated
  client_comm_failed
  document_waived
  document_accepted
  auth_login_succeeded
  auth_login_failed
  auth_logout
  auth_role_changed
  consultation_transition_blocked
  consultation_invite_release_blocked_risk
  consultation_invited
  consultation_booked
  consultation_rescheduled
  consultation_completed
  consultation_no_show
  consultation_cancelled
  consultation_outcome_recorded
  csa_issued
  deposit_recorded
  client_summary_released
}

enum ClientCommunicationType {
  request_more_information
  consultation_invitation
  not_progressing_hold
}

enum ClientCommunicationStatus {
  drafted_internal
  pending_staff_release
  released
  blocked
  failed
}

model IntakeSubmission {
  id                      String           @id @default(uuid())
  status                  SubmissionStatus @default(draft)
  payload                 Json
  currentReviewState      SubmissionReviewState?
  documents               SubmissionDocument[]
  reviews                 StaffReview[]
  pointsSnapshots         PointsSnapshot[]
  riskFlags               RiskFlag[]
  auditEvents             AuditEvent[]
  clientCommunications    ClientCommunication[]
  consultationBookings    ConsultationBooking[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  submittedAt             DateTime?
  clientSummaryReleasedAt DateTime?

  @@index([status, updatedAt])
}

model SubmissionDocument {
  id                        String                     @id @default(uuid())
  submissionId              String
  submission                IntakeSubmission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentType              DocumentType
  originalFilename          String
  mimeType                  String
  fileSizeBytes             Int
  storageKey                String
  uploadedBy                UploadedBy
  verificationStatus        DocumentVerificationStatus @default(uploaded_unchecked)
  verificationNotesInternal String?
  rejectionReasonClientSafe String?
  // Waiver fields allow mandatory document review gates to be satisfied with explicit staff-approved exceptions.
  waived                    Boolean                    @default(false)
  waivedReason              String?
  waivedBy                  String?
  waivedAt                  DateTime?
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  verifiedBy                String?
  uploadedAt                DateTime                   @default(now())
  verifiedAt                DateTime?

  @@index([submissionId])
  @@index([documentType])
  @@index([submissionId, verificationStatus])
}

model StaffReview {
  id                 String         @id @default(uuid())
  submissionId       String
  submission         IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stage              ReviewStage
  decision           ReviewDecision
  internalNotes      String
  missingEvidence    String[]
  nextActionOwner    String?
  nextActionDueDate  DateTime?
  clientSafeSummary  String?
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  reviewedBy         String
  createdAt          DateTime       @default(now())

  @@index([submissionId])
  @@index([stage])
  @@index([submissionId, createdAt])
}

model SubmissionReviewState {
  id                    String           @id @default(uuid())
  submissionId          String           @unique
  submission            IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  currentStage          ReviewStage
  lastDecision          ReviewDecision?
  mandatoryStagesComplete Boolean        @default(false)
  releaseChecklistSigned Boolean         @default(false)
  // Workflow guardrails must still be enforced in service/API logic, not only database schema constraints.
  createdAt             DateTime         @default(now())
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  seniorSignOffBy       String?
  seniorSignOffAt       DateTime?
  updatedAt             DateTime         @updatedAt
}

model PointsSnapshot {
  id               String           @id @default(uuid())
  submissionId     String
  submission       IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  calculatorVersion String
  inputPayload     Json
  totalPoints      Int
  pointsBreakdown  Json
  missingItems     String[]
  generatedBy      PointsGeneratedBy
  preliminaryLabel String           @default("Preliminary only; subject to human review.")
  generatedAt      DateTime         @default(now())

  @@index([submissionId])
}

model RiskFlag {
  id                        String               @id @default(uuid())
  submissionId              String
  submission                IntakeSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  riskCode                  String
  severity                  RiskSeverity
  detectedBy                RiskDetectedBy
  resolutionStatus          RiskResolutionStatus @default(open)
  resolutionSummaryInternal String?
  clientSafeDisclosure      String?
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  resolvedBy                String?
  detectedAt                DateTime             @default(now())
  resolvedAt                DateTime?

  @@index([submissionId])
  @@index([severity])
  @@index([submissionId, resolutionStatus, severity])
}

model ConsultationBooking {
  id                      String                    @id @default(uuid())
  submissionId            String
  submission              IntakeSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  clientName              String
  clientEmail             String
  assignedSeniorStaffId   String?
  assignedSeniorStaffName String?
  bookingDateTime         DateTime?
  bookingTimezone         String?
  bookingSource           ConsultationBookingSource @default(manual_staff_entry)
  status                  ConsultationBookingStatus @default(invited)
  consultationOutcome     String?
  csaRecommended          Boolean?
  csaIssued               Boolean                   @default(false)
  csaIssuedAt             DateTime?
  depositPaid             Boolean                   @default(false)
  depositPaidAt           DateTime?
  notesInternal           String?
  invitedAt               DateTime?
  bookedAt                DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  noShowAt                DateTime?
  rescheduledAt           DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([submissionId])
  @@index([status, bookingDateTime])
  @@index([assignedSeniorStaffId, status, bookingDateTime])
  @@index([bookingSource, createdAt])
}

model AuditEvent {
  id            String           @id @default(uuid())
  submissionId  String
  submission    IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  eventType     AuditEventType
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  actorId       String?
  actorRole     String?
  actorName     String?
  relatedEntityType String?
  relatedEntityId String?
  eventAt       DateTime         @default(now())
  fromStatus    SubmissionStatus?
  toStatus      SubmissionStatus?
  fromValue     Json?
  toValue       Json?
  reason        String?
  internalNote  String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  eventSource   String?

  @@index([submissionId])
  @@index([eventType])
  @@index([submissionId, eventAt])
}

model ClientCommunication {
  id                String                    @id @default(cuid())
  submissionId      String
  submission        IntakeSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type              ClientCommunicationType
  status            ClientCommunicationStatus
  subject           String
  bodyText          String
  templateVersion   String
  internalReason    String
  requiresRiskClearance Boolean               @default(false)
  releasedBy        String?
  releasedAt        DateTime?
  provider          String?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([submissionId, createdAt])
  @@index([submissionId, type, status])
  @@index([status, updatedAt])
}
