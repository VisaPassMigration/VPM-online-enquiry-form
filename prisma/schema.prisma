generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  draft
  submitted
  intake_triage_in_progress
  awaiting_client_documents
  document_review_in_progress
  risk_review_in_progress
  preliminary_points_review_in_progress
  senior_review_in_progress
  ready_for_client_summary
  client_summary_sent
  on_hold
  closed
}

enum DocumentType {
  passportBioPage
  resume
  qualificationsDoc
  transcripts
  englishResultDoc
  skillsAssessmentDoc
  refusalDocs
  otherSupportingDocs
}

enum DocumentVerificationStatus {
  not_uploaded
  uploaded_unchecked
  under_review
  verified
  rejected
  needs_reupload
}

enum UploadedBy {
  client
  staff
}

enum ReviewStage {
  intake_triage
  document_completeness_check
  risk_assessment
  preliminary_points_review
  senior_consultant_check
  client_summary_ready
}

enum ReviewDecision {
  insufficient_information
  needs_more_documents
  needs_risk_clarification
  ready_for_consultant_summary
  manual_hold
}

enum RiskSeverity {
  low
  medium
  high
  critical
}

enum RiskDetectedBy {
  system
  staff
}

enum RiskResolutionStatus {
  open
  under_review
  resolved
  accepted_with_controls
}

enum ConsultationBookingStatus {
  invited
  booked
  completed
  no_show
  cancelled
  rescheduled
}

enum ConsultationBookingSource {
  manual_staff_entry
  internal_booking_link
  calendly
  google_calendar
  other
}

enum PointsGeneratedBy {
  system
  staff
}

enum LeadRating {
  hot
  warm
  cold
  escalate
}

enum ClearReportStatus {
  draft
  prepared
  reviewed
  approved_for_consultation
  shared_with_client
}

enum MigrationReferenceDatasetStatus {
  draft
  reviewed
  approved
  stale
  archived
}

enum AuditEventType {
  submission_created
  submission_updated
  submission_submitted
  document_uploaded
  document_verified
  document_rejected
  status_transition_executed
  risk_flag_created
  risk_flag_resolved
  points_snapshot_generated
  points_snapshot_regenerated
  client_comm_drafted
  client_comm_release_requested
  client_comm_released
  client_comm_release_blocked
  review_note_added
  risk_escalated
  client_comm_failed
  document_waived
  document_accepted
  auth_login_succeeded
  auth_login_failed
  auth_logout
  auth_role_changed
  consultation_transition_blocked
  consultation_invite_release_blocked_risk
  consultation_invited
  consultation_booked
  consultation_rescheduled
  consultation_completed
  consultation_no_show
  consultation_cancelled
  consultation_outcome_recorded
  csa_issued
  deposit_recorded
  client_summary_released
  lead_rating_suggested
  lead_rating_confirmed
  lead_rating_changed
  enquiry_faq_email_drafted
  enquiry_faq_email_sent
  enquiry_faq_email_failed
  intake_link_sent
  intake_link_clicked
  clear_report_generated
  clear_report_updated
  clear_report_reviewed
  clear_report_approved
  clear_report_shared
  clear_report_prepared
  clear_report_approval_requested
  clear_report_australia_review_requested
  clear_report_australia_review_completed
  clear_report_approval_blocked
  clear_report_override_approved
  migration_reference_dataset_imported
  migration_reference_dataset_reviewed
  migration_reference_dataset_approved
  migration_reference_dataset_marked_stale
}

enum ClientCommunicationType {
  request_more_information
  consultation_invitation
  not_progressing_hold
}

enum EnquiryCommunicationType {
  faq_general_migration
  faq_skilled_migration
  faq_student_visa
  faq_partner_family
  faq_employer_sponsored
  faq_insufficient_information
}

enum EnquiryCommunicationStatus {
  drafted_internal
  pending_staff_release
  sent
  failed
  cancelled
}

enum ClientCommunicationStatus {
  drafted_internal
  pending_staff_release
  released
  blocked
  failed
}

model IntakeSubmission {
  id                      String           @id @default(uuid())
  status                  SubmissionStatus @default(draft)
  payload                 Json
  currentReviewState      SubmissionReviewState?
  documents               SubmissionDocument[]
  reviews                 StaffReview[]
  pointsSnapshots         PointsSnapshot[]
  riskFlags               RiskFlag[]
  auditEvents             AuditEvent[]
  clientCommunications    ClientCommunication[]
  enquiries               Enquiry[]
  enquiryCommunications   EnquiryCommunication[]
  consultationBookings    ConsultationBooking[]
  clearReports            ClearReport[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  submittedAt             DateTime?
  clientSummaryReleasedAt DateTime?
  leadRating              LeadRating?
  leadRatingReason        String?
  leadRatingSuggested     LeadRating?
  leadRatingSuggestedAt   DateTime?
  leadRatingConfirmedBy   String?
  leadRatingConfirmedAt   DateTime?

  @@index([status, updatedAt])
  @@index([leadRating, updatedAt])
  @@index([leadRatingSuggested, leadRatingSuggestedAt])
}

model ClearReport {
  id                       String            @id @default(uuid())
  submissionId             String
  submission               IntakeSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  consultationBookingId    String?
  status                   ClearReportStatus @default(draft)
  reportVersion            String
  generatedSnapshotJson    Json
  staffNotes               String?
  clientFacingNotes        String?
  preparedByStaffUserId    String?
  preparedAt               DateTime?
  reviewedByStaffUserId    String?
  reviewedAt               DateTime?
  approvedByStaffUserId    String?
  approvedAt               DateTime?
  approvalScope            String?
  requiresAustraliaReview  Boolean           @default(false)
  australiaReviewReason    String?
  australiaReviewedByStaffUserId String?
  australiaReviewedAt      DateTime?
  escalationReason         String?
  reviewNotes              String?
  sharedByStaffUserId      String?
  sharedAt                 DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([submissionId, createdAt])
  @@index([status, updatedAt])
  @@index([consultationBookingId])
}

model MigrationReferenceDataset {
  id                      String                          @id @default(uuid())
  datasetVersion          String                          @unique
  status                  MigrationReferenceDatasetStatus @default(draft)
  sourceSummary           String?
  sourceUrls              Json?
  importedAt              DateTime                        @default(now())
  reviewedByStaffUserId   String?
  reviewedAt              DateTime?
  approvedByStaffUserId   String?
  approvedAt              DateTime?
  staleAt                 DateTime?
  notes                   String?
  occupationReferences    OccupationReference[]
  costReferences          CostReference[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([status, reviewedAt])
  @@index([status, approvedAt])
}

model OccupationReference {
  id                     String                     @id @default(uuid())
  datasetId              String
  dataset                MigrationReferenceDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  occupationCode         String
  occupationTitle        String
  classificationSource   String?
  possibleVisaSubclasses Json?
  occupationListSource   String?
  assessingAuthority     String?
  shortageIndicator      String?
  sourceUrl              String?
  sourceDate             DateTime?
  notes                  String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([datasetId, occupationCode])
  @@index([occupationTitle])
  @@index([assessingAuthority])
}

model CostReference {
  id          String                    @id @default(uuid())
  datasetId   String
  dataset     MigrationReferenceDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  category    String
  label       String
  amount      String?
  currency    String?
  sourceUrl   String?
  sourceDate  DateTime?
  notes       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([datasetId, category])
}

model SubmissionDocument {
  id                        String                     @id @default(uuid())
  submissionId              String
  submission                IntakeSubmission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentType              DocumentType
  originalFilename          String
  mimeType                  String
  fileSizeBytes             Int
  storageKey                String
  uploadedBy                UploadedBy
  verificationStatus        DocumentVerificationStatus @default(uploaded_unchecked)
  verificationNotesInternal String?
  rejectionReasonClientSafe String?
  // Waiver fields allow mandatory document review gates to be satisfied with explicit staff-approved exceptions.
  waived                    Boolean                    @default(false)
  waivedReason              String?
  waivedBy                  String?
  waivedAt                  DateTime?
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  verifiedBy                String?
  uploadedAt                DateTime                   @default(now())
  verifiedAt                DateTime?

  @@index([submissionId])
  @@index([documentType])
  @@index([submissionId, verificationStatus])
}

model StaffReview {
  id                 String         @id @default(uuid())
  submissionId       String
  submission         IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stage              ReviewStage
  decision           ReviewDecision
  internalNotes      String
  missingEvidence    String[]
  nextActionOwner    String?
  nextActionDueDate  DateTime?
  clientSafeSummary  String?
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  reviewedBy         String
  createdAt          DateTime       @default(now())

  @@index([submissionId])
  @@index([stage])
  @@index([submissionId, createdAt])
}

model SubmissionReviewState {
  id                    String           @id @default(uuid())
  submissionId          String           @unique
  submission            IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  currentStage          ReviewStage
  lastDecision          ReviewDecision?
  mandatoryStagesComplete Boolean        @default(false)
  releaseChecklistSigned Boolean         @default(false)
  // Workflow guardrails must still be enforced in service/API logic, not only database schema constraints.
  createdAt             DateTime         @default(now())
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  seniorSignOffBy       String?
  seniorSignOffAt       DateTime?
  updatedAt             DateTime         @updatedAt
}

model PointsSnapshot {
  id               String           @id @default(uuid())
  submissionId     String
  submission       IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  calculatorVersion String
  inputPayload     Json
  totalPoints      Int
  pointsBreakdown  Json
  missingItems     String[]
  generatedBy      PointsGeneratedBy
  preliminaryLabel String           @default("Preliminary only; subject to human review.")
  generatedAt      DateTime         @default(now())

  @@index([submissionId])
}

model RiskFlag {
  id                        String               @id @default(uuid())
  submissionId              String
  submission                IntakeSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  riskCode                  String
  severity                  RiskSeverity
  detectedBy                RiskDetectedBy
  resolutionStatus          RiskResolutionStatus @default(open)
  resolutionSummaryInternal String?
  clientSafeDisclosure      String?
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  resolvedBy                String?
  detectedAt                DateTime             @default(now())
  resolvedAt                DateTime?

  @@index([submissionId])
  @@index([severity])
  @@index([submissionId, resolutionStatus, severity])
}

model ConsultationBooking {
  id                      String                    @id @default(uuid())
  submissionId            String
  submission              IntakeSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  clientName              String
  clientEmail             String
  assignedSeniorStaffId   String?
  assignedSeniorStaffName String?
  bookingDateTime         DateTime?
  bookingTimezone         String?
  bookingSource           ConsultationBookingSource @default(manual_staff_entry)
  status                  ConsultationBookingStatus @default(invited)
  consultationOutcome     String?
  csaRecommended          Boolean?
  csaIssued               Boolean                   @default(false)
  csaIssuedAt             DateTime?
  depositPaid             Boolean                   @default(false)
  depositPaidAt           DateTime?
  notesInternal           String?
  invitedAt               DateTime?
  bookedAt                DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  noShowAt                DateTime?
  rescheduledAt           DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([submissionId])
  @@index([status, bookingDateTime])
  @@index([assignedSeniorStaffId, status, bookingDateTime])
  @@index([bookingSource, createdAt])
}

model AuditEvent {
  id            String           @id @default(uuid())
  submissionId  String
  submission    IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  eventType     AuditEventType
  // Actor identity fields remain plain strings in V1 and may later be normalized into StaffUser relations.
  actorId       String?
  actorRole     String?
  actorName     String?
  actorStaffUserId String?
  actorStaffUser StaffUser? @relation("AuditEventActorStaffUser", fields: [actorStaffUserId], references: [id])
  relatedEntityType String?
  relatedEntityId String?
  eventAt       DateTime         @default(now())
  fromStatus    SubmissionStatus?
  toStatus      SubmissionStatus?
  fromValue     Json?
  toValue       Json?
  reason        String?
  internalNote  String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  eventSource   String?

  @@index([submissionId])
  @@index([eventType])
  @@index([submissionId, eventAt])
  @@index([actorStaffUserId])
}


model Enquiry {
  id                  String                 @id @default(uuid())
  firstName           String?
  lastName            String?
  email               String
  phone               String?
  enquirySource       String?
  enquiryMessage      String?
  countryOfResidence  String?
  nationality         String?
  intendedPathway     String?
  intakeSubmissionId  String?
  intakeSubmission    IntakeSubmission?      @relation(fields: [intakeSubmissionId], references: [id], onDelete: SetNull)
  communications      EnquiryCommunication[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([email])
  @@index([intakeSubmissionId])
}

model EnquiryCommunication {
  id                    String                     @id @default(uuid())
  enquiryId             String
  enquiry               Enquiry                    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  intakeSubmissionId    String?
  intakeSubmission      IntakeSubmission?          @relation(fields: [intakeSubmissionId], references: [id], onDelete: SetNull)
  type                  EnquiryCommunicationType
  status                EnquiryCommunicationStatus @default(drafted_internal)
  subject               String
  bodyText              String
  templateVersion       String
  intakeLinkUrlSnapshot String?
  provider              String?
  providerMessageId     String?
  failureReason         String?
  sentByStaffUserId     String?
  sentByStaffUser       StaffUser?                 @relation(fields: [sentByStaffUserId], references: [id], onDelete: SetNull)
  sentAt                DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([enquiryId, createdAt])
  @@index([status, updatedAt])
  @@index([type, status])
}

model ClientCommunication {
  id                String                    @id @default(cuid())
  submissionId      String
  submission        IntakeSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type              ClientCommunicationType
  status            ClientCommunicationStatus
  subject           String
  bodyText          String
  templateVersion   String
  internalReason    String
  requiresRiskClearance Boolean               @default(false)
  releasedBy        String?
  releasedAt        DateTime?
  provider          String?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([submissionId, createdAt])
  @@index([submissionId, type, status])
  @@index([status, updatedAt])
}

model StaffUser {
  id                       String          @id @default(uuid())
  authUserId               String          @unique
  email                    String          @unique
  displayName              String?
  team                     String?
  location                 String?
  isActive                 Boolean         @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  staffRoles               StaffUserRole[] @relation("StaffRoleAssignments")
  assignedRoles            StaffUserRole[] @relation("RoleAssignedByStaff")
  auditEventsAsActor       AuditEvent[]   @relation("AuditEventActorStaffUser")
  sentEnquiryCommunications EnquiryCommunication[]
}

model StaffRole {
  id         String          @id @default(uuid())
  key        String          @unique
  name       String
  description String?
  isSystem   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  staffUsers StaffUserRole[] @relation("StaffRoleAssignments")
}

model StaffUserRole {
  staffUserId           String
  staffRoleId           String
  assignedByStaffUserId String?
  assignedAt            DateTime  @default(now())
  revokedAt             DateTime?
  staffUser             StaffUser @relation("StaffRoleAssignments", fields: [staffUserId], references: [id], onDelete: Cascade)
  staffRole             StaffRole @relation("StaffRoleAssignments", fields: [staffRoleId], references: [id], onDelete: Cascade)
  assignedByStaffUser   StaffUser? @relation("RoleAssignedByStaff", fields: [assignedByStaffUserId], references: [id])

  @@id([staffUserId, staffRoleId])
  @@index([staffRoleId, revokedAt])
}
